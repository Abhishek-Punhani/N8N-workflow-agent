# ═══════════════════════════════════════════════════════════════════════════════
# AI Data Intelligence Platform — Dashboard Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values as needed.
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API URL for the Vite dev-server proxy.
# In production, the proxy is configured at the Nginx/Docker level — this is
# only needed for local development if the backend is NOT on localhost:3000.
VITE_API_BASE_URL=http://localhost:3000
