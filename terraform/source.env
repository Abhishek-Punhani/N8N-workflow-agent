# GCP Configuration
export TF_VAR_project_id="your-gcp-project-id"
export TF_VAR_region="us-central1"
export TF_VAR_zone="us-central1-a"
export TF_VAR_machine_type="e2-medium"
export TF_VAR_instance_name="n8n-agent-platform"

# Cloudflare Configuration
export TF_VAR_cloudflare_api_token="your-cloudflare-api-token"
export TF_VAR_cloudflare_zone_id="your-cloudflare-zone-id"
export TF_VAR_domain_name="dashboard.example.com"
export TF_VAR_admin_email="admin@example.com"

# GitHub Configuration
export TF_VAR_github_username="your-github-username"
export TF_VAR_github_token="your-personal-access-token"

# Repository Configuration
export TF_VAR_repo_url="https://github.com/Abhishek-Punhani/N8N-workflow-agent.git"
export TF_VAR_branch_name="master"
