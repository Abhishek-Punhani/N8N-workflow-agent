# Copy to .env. Never commit secrets. Docker Compose reads this file.
NODE_ENV=development
PORT=3000

# REQUIRED: LLM Provider selection (gemini or groq)
LLM_PROVIDER=gemini

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Groq configuration (required if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
TIMEOUT_LLM_MS=120000
TIMEOUT_N8N_MS=120000

# REQUIRED: generate each independently with: openssl rand -hex 32
PLATFORM_API_TOKEN=
DB_PASSWORD=
N8N_ENCRYPTION_KEY=
SEARCH_SECRET=
# n8n owner account. Use a strong password with upper/lowercase and numbers.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=

# Docker keeps PostgreSQL and platform on its private network.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_data_db
DB_USER=ai_platform
N8N_BASE_URL=http://localhost:5678
# Bare-metal or externally managed n8n only. Compose provisions a key in a volume.
N8N_API_KEY=

LIMIT_MAX_RECORDS=1000000
LIMIT_MAX_EXPORT_SIZE_MB=500
# General collection: total pages per run across all sources.
LIMIT_WEB_PAGES=30
LIMIT_COLLECTION_RECORDS=500
LIMIT_COLLECTION_MODEL_CALLS=40
TIMEOUT_COLLECTION_MS=300000
COLLECTION_BROWSER_ENABLED=true
# Compose provides private SearXNG by default. No extra search API key required.
SEARCH_PROVIDER=searxng
# Bare-metal: set this to your SearXNG URL. Compose defaults to http://search:8080.
SEARCH_BASE_URL=
# Required only when SEARCH_PROVIDER=tavily or brave.
SEARCH_API_KEY=
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=80
PLATFORM_PORT=3000
N8N_PORT=5678
# Set true behind HTTPS. False is only for loopback HTTP development.
COOKIE_SECURE=false
N8N_SECURE_COOKIE=false
