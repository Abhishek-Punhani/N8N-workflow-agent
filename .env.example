# ═══════════════════════════════════════════════════════════════════════════════
# AI Data Intelligence Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:   cp .env.example .env
# 2. Fill in ALL values marked as REQUIRED.
# 3. Never commit your .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
# Options: development | staging | production | test
NODE_ENV=development

# Port the backend HTTP server listens on
PORT=3000

# ── LLM Configuration ────────────────────────────────────────────────────────
# REQUIRED: Your LLM API key
LLM_API_KEY=

# LLM endpoint — defaults to OpenAI, swap for any compatible API
LLM_ENDPOINT=https://api.openai.com/v1

# Model to use for Intake Agent, Workflow Planner, and Repair Agent
LLM_MODEL=gemini-3.1-pro

# ── n8n Configuration ────────────────────────────────────────────────────────
# REQUIRED: Base URL of your n8n instance
# Local dev:    http://localhost:5678
# Docker stack: http://n8n:5678
N8N_BASE_URL=http://localhost:5678

# REQUIRED: n8n API key (Settings → API → Create new key)
N8N_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection details (used when Task 10 persistence layer is live)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_data_db
DB_USER=ai_platform
DB_PASSWORD=

# ── Platform Limits ──────────────────────────────────────────────────────────
# Maximum records returned in a single export (hard limit enforced by platform)
LIMIT_MAX_RECORDS=1000000

# Maximum export file size in megabytes
LIMIT_MAX_EXPORT_SIZE_MB=500

# ── Timeouts (milliseconds) ───────────────────────────────────────────────────
# Timeout for LLM requests (Intake Agent, Planner, Repair Agent)
TIMEOUT_LLM_MS=30000

# Timeout for n8n API calls (deploy, activate, sandbox execute)
TIMEOUT_N8N_MS=30000
